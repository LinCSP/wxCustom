:root {
    --primary: #3498db;
    --hover: #2980b9;
    --pressed: #1c6ea4;
    --bg: #ecf0f1;
    --disabled-bg: #bdc3c7;
    --disabled-border: #95a5a6;
    --disabled-color: #7f8c8d;
    --panel-bg: #ffffff;
    --text: #2c3e50;
}

.title {
    color: var(--text);
    font-size: 24dip;
    font-weight: bold;
    text-align: center;
}

.section-header {
    color: var(--primary);
    font-size: 12dip;
    font-weight: bold;
    text-align: left;
    text-transform: uppercase;
}

StyledPanel {
    background-color: #ffffff;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 8dip;
    padding: 16dip;
}

StyledLabel {
    color: #2c3e50;
    font-size: 16dip;
    text-align: center;
}

StyledToggleButton {
    background-color: #ecf0f1;
    color: #2c3e50;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 4dip;
    padding: 8dip 16dip;
    text-align: center;
    min-width: 80dip;
    min-height: 32dip;
}

StyledToggleButton:hover {
    background-color: #d0d3d4;
}

StyledToggleButton:pressed {
    background-color: #bfc9ca;
}

StyledToggleButton:checked {
    background-color: var(--primary);
    color: #ffffff;
    border-color: var(--hover);
}

StyledToggleButton:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledToggleButton:disabled {
    background-color: var(--disabled-bg);
    border-color: var(--disabled-border);
    color: var(--disabled-color);
}

StyledCheckBox {
    color: #2c3e50;
    padding: 4dip;
    spacing: 8dip;
    text-align: left;
}

StyledCheckBox::indicator {
    width: 18dip;
    height: 18dip;
    background-color: #ffffff;
    border-width: 2dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 3dip;
}

StyledCheckBox::indicator:hover {
    border-color: var(--primary);
}

StyledCheckBox::indicator:checked {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
}

StyledCheckBox::indicator:indeterminate {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
}

StyledCheckBox::indicator:pressed {
    background-color: #d6eaf8;
}

StyledCheckBox:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledCheckBox:disabled {
    color: var(--disabled-color);
}

StyledCheckBox::indicator:disabled {
    background-color: #e5e8e8;
    border-color: var(--disabled-border);
}

StyledCheckBox::indicator:disabled:checked,
StyledCheckBox::indicator:disabled:indeterminate {
    background-color: #aed6f1;
    border-color: #85c1e9;
    color: #ffffff;
}

StyledRadioButton {
    color: #2c3e50;
    padding: 4dip;
    spacing: 8dip;
    text-align: left;
}

StyledRadioButton::indicator {
    width: 18dip;
    height: 18dip;
    background-color: #ffffff;
    border-width: 2dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 50%;
}

StyledRadioButton::indicator:hover {
    border-color: var(--primary);
}

StyledRadioButton::indicator:checked {
    border-color: var(--primary);
    color: var(--primary);
}

StyledRadioButton::indicator:pressed {
    background-color: #d6eaf8;
}

StyledRadioButton:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledRadioButton:disabled {
    color: var(--disabled-color);
}

StyledRadioButton::indicator:disabled {
    background-color: #e5e8e8;
    border-color: var(--disabled-border);
}

StyledRadioButton::indicator:disabled:checked {
    border-color: #85c1e9;
    color: #aed6f1;
}

DemoWidget {
    background-color: var(--bg);
    border-width: 2dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 6dip;
    color: #2c3e50;
    padding: 8dip;
    min-width: 80dip;
    min-height: 32dip;
}

DemoWidget:hover {
    background-color: var(--hover);
    border-color: var(--primary);
    color: #ffffff;
}

DemoWidget:focused {
    outline-width: 3dip;
    outline-color: var(--primary);
    outline-offset: 2dip;
}

StyledButton {
    background-color: var(--primary);
    color: #ffffff;
    border-width: 1dip;
    border-color: var(--hover);
    border-style: solid;
    border-radius: 4dip;
    padding: 8dip 16dip;
    text-align: center;
    min-width: 80dip;
    min-height: 32dip;
}

StyledButton:hover {
    background-color: var(--hover);
}

StyledButton:pressed {
    background-color: var(--pressed);
}

StyledButton:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledButton:disabled {
    background-color: var(--disabled-bg);
    border-color: var(--disabled-border);
    color: var(--disabled-color);
}

StyledLineEdit {
    background-color: #ffffff;
    color: #2c3e50;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 4dip;
    padding: 6dip 8dip;
    font-size: 12dip;
    min-width: 120dip;
    min-height: 24dip;
}

StyledLineEdit:hover {
    border-color: #3498db;
}

StyledLineEdit:focused {
    border-color: var(--primary);
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledLineEdit:disabled {
    background-color: #ecf0f1;
    border-color: #bdc3c7;
    color: var(--disabled-color);
}

StyledLineEdit:read-only {
    background-color: #f4f6f7;
    color: #7f8c8d;
}

StyledMessageDialog {
    background-color: #ffffff;
    color: #2c3e50;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 8dip;
    padding: 24dip;
    font-size: 12dip;
    spacing: 16dip;
}
