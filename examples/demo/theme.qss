:root {
    --primary: #3498db;
    --hover: #2980b9;
    --pressed: #1c6ea4;
    --bg: #ecf0f1;
    --disabled-bg: #bdc3c7;
    --disabled-border: #95a5a6;
    --disabled-color: #7f8c8d;
    --panel-bg: #ffffff;
    --text: #2c3e50;
}

.title {
    color: var(--text);
    font-size: 24dip;
    font-weight: bold;
    text-align: center;
}

.section-header {
    color: var(--primary);
    font-size: 12dip;
    font-weight: bold;
    text-align: left;
    text-transform: uppercase;
}

StyledPanel {
    background-color: #ffffff;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 8dip;
    padding: 16dip;
}

StyledLabel {
    color: #2c3e50;
    font-size: 16dip;
    text-align: center;
}

StyledToggleButton {
    background-color: #ecf0f1;
    color: #2c3e50;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 4dip;
    padding: 8dip 16dip;
    text-align: center;
    min-width: 80dip;
    min-height: 32dip;
}

StyledToggleButton:hover {
    background-color: #d0d3d4;
}

StyledToggleButton:pressed {
    background-color: #bfc9ca;
}

StyledToggleButton:checked {
    background-color: var(--primary);
    color: #ffffff;
    border-color: var(--hover);
}

StyledToggleButton:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledToggleButton:disabled {
    background-color: var(--disabled-bg);
    border-color: var(--disabled-border);
    color: var(--disabled-color);
}

StyledCheckBox {
    color: #2c3e50;
    padding: 4dip;
    spacing: 8dip;
    text-align: left;
}

StyledCheckBox::indicator {
    width: 18dip;
    height: 18dip;
    background-color: #ffffff;
    border-width: 2dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 3dip;
}

StyledCheckBox::indicator:hover {
    border-color: var(--primary);
}

StyledCheckBox::indicator:checked {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
}

StyledCheckBox::indicator:indeterminate {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
}

StyledCheckBox::indicator:pressed {
    background-color: #d6eaf8;
}

StyledCheckBox:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledCheckBox:disabled {
    color: var(--disabled-color);
}

StyledCheckBox::indicator:disabled {
    background-color: #e5e8e8;
    border-color: var(--disabled-border);
}

StyledCheckBox::indicator:disabled:checked,
StyledCheckBox::indicator:disabled:indeterminate {
    background-color: #aed6f1;
    border-color: #85c1e9;
    color: #ffffff;
}

StyledRadioButton {
    color: #2c3e50;
    padding: 4dip;
    spacing: 8dip;
    text-align: left;
}

StyledRadioButton::indicator {
    width: 18dip;
    height: 18dip;
    background-color: #ffffff;
    border-width: 2dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 50%;
}

StyledRadioButton::indicator:hover {
    border-color: var(--primary);
}

StyledRadioButton::indicator:checked {
    border-color: var(--primary);
    color: var(--primary);
}

StyledRadioButton::indicator:pressed {
    background-color: #d6eaf8;
}

StyledRadioButton:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledRadioButton:disabled {
    color: var(--disabled-color);
}

StyledRadioButton::indicator:disabled {
    background-color: #e5e8e8;
    border-color: var(--disabled-border);
}

StyledRadioButton::indicator:disabled:checked {
    border-color: #85c1e9;
    color: #aed6f1;
}

DemoWidget {
    background-color: var(--bg);
    border-width: 2dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 6dip;
    color: #2c3e50;
    padding: 8dip;
    min-width: 80dip;
    min-height: 32dip;
}

DemoWidget:hover {
    background-color: var(--hover);
    border-color: var(--primary);
    color: #ffffff;
}

DemoWidget:focused {
    outline-width: 3dip;
    outline-color: var(--primary);
    outline-offset: 2dip;
}

StyledButton {
    background-color: var(--primary);
    color: #ffffff;
    border-width: 1dip;
    border-color: var(--hover);
    border-style: solid;
    border-radius: 4dip;
    padding: 8dip 16dip;
    text-align: center;
    min-width: 80dip;
    min-height: 32dip;
}

StyledButton:hover {
    background-color: var(--hover);
}

StyledButton:pressed {
    background-color: var(--pressed);
}

StyledButton:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledButton:disabled {
    background-color: var(--disabled-bg);
    border-color: var(--disabled-border);
    color: var(--disabled-color);
}

StyledLineEdit {
    background-color: #ffffff;
    color: #2c3e50;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 4dip;
    padding: 6dip 8dip;
    font-size: 12dip;
    min-width: 120dip;
    min-height: 24dip;
}

StyledLineEdit:hover {
    border-color: #3498db;
}

StyledLineEdit:focused {
    border-color: var(--primary);
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledLineEdit:disabled {
    background-color: #ecf0f1;
    border-color: #bdc3c7;
    color: var(--disabled-color);
}

StyledLineEdit:read-only {
    background-color: #f4f6f7;
    color: #7f8c8d;
}

StyledComboBox {
    background-color: #ffffff;
    color: #2c3e50;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 4dip;
    padding: 6dip 4dip 6dip 8dip;
    font-size: 12dip;
    text-align: left;
    min-width: 120dip;
    min-height: 24dip;
}

StyledComboBox:hover {
    border-color: #3498db;
}

StyledComboBox:focused {
    border-color: var(--primary);
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledComboBox:disabled {
    background-color: #ecf0f1;
    border-color: #bdc3c7;
    color: var(--disabled-color);
}

StyledComboBox::drop-down {
    width: 20dip;
    background-color: transparent;
}

StyledComboBox::down-arrow {
    color: #7f8c8d;
    /* border-width controls the thickness of the chevron lines. */
    border-width: 2dip;
}

StyledComboBox::item {
    background-color: #ffffff;
    color: #2c3e50;
    padding: 6dip 8dip;
    text-align: left;
}

StyledComboBox::item:hover {
    background-color: #eaf2f8;
}

StyledComboBox::item:selected {
    background-color: var(--primary);
    color: #ffffff;
}

StyledSlider {
    min-height: 32dip;
}

StyledSlider::groove {
    background-color: #dee2e6;
    border-radius: 3dip;
    height: 6dip;
}

StyledSlider::sub-page {
    background-color: #0d6efd;
    border-radius: 3dip;
}

StyledSlider::handle {
    width: 18dip;
    height: 18dip;
    background-color: #0d6efd;
    border-radius: 50%;
}

StyledSlider::handle:hover {
    background-color: #0b5ed7;
}

StyledSlider::handle:pressed {
    background-color: #0a58ca;
}

StyledSlider:focused {
    outline-width: 2dip;
    outline-color: rgba(13, 110, 253, 0.5);
    outline-offset: 2dip;
}

StyledSlider:disabled {
    opacity: 0.65;
}

StyledProgressBar {
    min-height: 24dip;
    color: #2c3e50;
    font-size: 10dip;
    font-weight: bold;
}

StyledProgressBar::groove {
    background-color: #e9ecef;
    border-radius: 4dip;
    height: 16dip;
}

StyledProgressBar::chunk {
    background-color: #0d6efd;
    border-radius: 4dip;
}

StyledProgressBar:disabled {
    opacity: 0.65;
}

StyledGroupBox {
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 4dip;
    padding: 0dip 12dip 12dip 12dip;
}

StyledGroupBox::title {
    color: var(--primary);
    font-size: 12dip;
    font-weight: bold;
    padding: 0dip 6dip;
}

StyledMessageDialog {
    background-color: #ffffff;
    color: #2c3e50;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 8dip;
    padding: 24dip;
    font-size: 12dip;
    spacing: 16dip;
}

/* StyledTabWidget styles (Bootstrap 5 nav-tabs look).
   Inactive tabs are borderless links; the selected tab is white, bordered on
   top/left/right with rounded top corners and covers the tab bar baseline. */
StyledTabWidget::tab-bar {
    border-bottom-width: 1dip;
    border-color: #dee2e6;
    border-style: solid;
    padding: 0dip;
}

StyledTabWidget::pane {
    background-color: #ffffff;
    padding: 0dip;
}

StyledTabWidget::tab {
    color: #0d6efd;
    padding: 8dip 16dip;
    border-width: 1dip;
    border-color: transparent;
    border-style: solid;
    border-radius: 6dip;
    text-align: center;
    min-width: 80dip;
    min-height: 32dip;
}

StyledTabWidget::tab:hover {
    color: #0a58ca;
    background-color: #f1f3f5;
}

StyledTabWidget::tab:pressed {
    color: #0a58ca;
    background-color: #e9ecef;
}

StyledTabWidget::tab:selected {
    background-color: #ffffff;
    color: #495057;
    border-color: #dee2e6;
}

StyledTabWidget::tab:disabled {
    color: var(--disabled-color);
}

StyledTabWidget:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

/* Pages inside StyledTabWidget: no own frame — the tab bar baseline is the
   only separator between the tabs and the content. */
StyledPanel.tab-page {
    border-width: 0dip;
    border-radius: 0dip;
}
