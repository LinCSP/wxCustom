:root {
    --primary: #3498db;
    --hover: #2980b9;
    --pressed: #1c6ea4;
    --bg: #ecf0f1;
    --disabled-bg: #bdc3c7;
    --disabled-border: #95a5a6;
    --disabled-color: #7f8c8d;
}

StyledPanel {
    background-color: #ffffff;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 8dip;
    padding: 16dip;
}

StyledLabel {
    color: #2c3e50;
    font-size: 16dip;
    text-align: center;
}

StyledToggleButton {
    background-color: #ecf0f1;
    color: #2c3e50;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 4dip;
    padding: 8dip 16dip;
    text-align: center;
    min-width: 80dip;
    min-height: 32dip;
}

StyledToggleButton:hover {
    background-color: #d0d3d4;
}

StyledToggleButton:pressed {
    background-color: #bfc9ca;
}

StyledToggleButton:checked {
    background-color: var(--primary);
    color: #ffffff;
    border-color: var(--hover);
}

StyledToggleButton:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

DemoWidget {
    background-color: var(--bg);
    border-width: 2dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 6dip;
    color: #2c3e50;
    padding: 8dip;
    min-width: 80dip;
    min-height: 32dip;
}

DemoWidget:hover {
    background-color: var(--hover);
    border-color: var(--primary);
    color: #ffffff;
}

DemoWidget:focused {
    outline-width: 3dip;
    outline-color: var(--primary);
    outline-offset: 2dip;
}

StyledButton {
    background-color: var(--primary);
    color: #ffffff;
    border-width: 1dip;
    border-color: var(--hover);
    border-style: solid;
    border-radius: 4dip;
    padding: 8dip 16dip;
    text-align: center;
    min-width: 80dip;
    min-height: 32dip;
}

StyledButton:hover {
    background-color: var(--hover);
}

StyledButton:pressed {
    background-color: var(--pressed);
}

StyledButton:focused {
    outline-width: 2dip;
    outline-color: #85c1e9;
    outline-offset: 2dip;
}

StyledButton:disabled {
    background-color: var(--disabled-bg);
    border-color: var(--disabled-border);
    color: var(--disabled-color);
}

StyledMessageDialog {
    background-color: #ffffff;
    color: #2c3e50;
    border-width: 1dip;
    border-color: #bdc3c7;
    border-style: solid;
    border-radius: 8dip;
    padding: 24dip;
    font-size: 12dip;
    spacing: 16dip;
}
